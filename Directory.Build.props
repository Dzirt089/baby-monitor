<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>ru</NeutralLanguage>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Единый источник версии (сейчас 0.3.0). Релизный workflow передаёт значения из SemVer-тега. -->
    <BabyMonitorVersionMajor>0</BabyMonitorVersionMajor>
    <BabyMonitorVersionMinor>3</BabyMonitorVersionMinor>
    <BabyMonitorVersionPatch>1</BabyMonitorVersionPatch>
    <VersionPrefix>$(BabyMonitorVersionMajor).$(BabyMonitorVersionMinor).$(BabyMonitorVersionPatch)</VersionPrefix>
    <BabyMonitorVersionCode>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(BabyMonitorVersionMajor), 10000)), $([MSBuild]::Multiply($(BabyMonitorVersionMinor), 100)))), $(BabyMonitorVersionPatch)))</BabyMonitorVersionCode>

    <Product>Радионяня</Product>
    <Authors>Baby Monitor contributors</Authors>
    <Copyright>Copyright (c) 2026 Baby Monitor contributors</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    ADR-0009: versionCode = MAJOR*10000 + MINOR*100 + PATCH. Некорректная версия должна падать
    на любой сборке, а не только в release workflow. Задачи <Error> допустимы только внутри Target.
  -->
  <Target Name="ValidateBabyMonitorVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="$(BabyMonitorVersionMinor) &gt;= 100" Text="BabyMonitorVersionMinor must be less than 100 (ADR-0009)." />
    <Error Condition="$(BabyMonitorVersionPatch) &gt;= 100" Text="BabyMonitorVersionPatch must be less than 100 (ADR-0009)." />
    <Error Condition="$(BabyMonitorVersionCode) &lt;= 0" Text="Computed BabyMonitorVersionCode must be positive (ADR-0009)." />
    <Error Condition="$(BabyMonitorVersionCode) &gt; 2100000000" Text="Computed BabyMonitorVersionCode exceeds the Android versionCode limit (ADR-0009)." />
  </Target>

</Project>