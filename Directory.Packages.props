<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- QR pairing UI (006 phase 2): ZXing.Net 0.16.11 — Apache-2.0, активно поддерживается
         (2026), только Platform.Android (рендеринг/декодирование QR), ADR-0011 + THIRD-PARTY-NOTICES. -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />

    <!-- Тестовые зависимости. -->
    <!-- SIPSorcery принят владельцем (ADR-0005); PackageReference добавлен в Infrastructure
          в 005 phase 2 (media/signaling, ADR-0007). Версия строго >= 10.0.17: ниже 10.0.14 —
          3 HIGH DoS-уязвимости, 10.0.17 — проверенная актуальная. Транзитивные зависимости
          (Concentus, BouncyCastle, DnsClient, Makaretu.Dns.Multicast, SIPSorcery.WebSocketSharp,
          SIPSorceryMedia.Abstractions) отражены в THIRD-PARTY-NOTICES. -->
    <PackageVersion Include="SIPSorcery" Version="10.0.17" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
